@article{joshiDeepTransferLearningStrategiesCrop2024,
  title = {Deep-{{Transfer-Learning Strategies}} for {{Crop Yield Prediction Using Climate Records}} and {{Satellite Image Time-Series Data}}},
  author = {Joshi, Abhasha and Pradhan, Biswajeet and Chakraborty, Subrata and Varatharajoo, Renuganth and Gite, Shilpa and Alamri, Abdullah},
  date = {2024-01},
  journaltitle = {Remote Sensing},
