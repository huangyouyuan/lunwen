@article{pengEvaluatingEffectivenessLandscape2010,
  title = {Evaluating the Effectiveness of Landscape Metrics in Quantifying Spatial Patterns},
  author = {Peng, Jian and Wang, Yanglin and Zhang, Yuan and Wu, Jiansheng and Li, Weifeng and Li, You},
  date = {2010-03-01},
