@article{russwurmMultitemporalLandCover2018,
  title = {Multi-Temporal Land Cover Classification with Sequential Recurrent Encoders},
  author = {Rußwurm, Marc and Körner, Marco},
  date = {2018},
  journaltitle = {ISPRS International Journal of Geo-Information},
  shortjournal = {ISPRS Int. J. Geo-Inf.},
