@article{weiEarlyCropMapping2023,
  title = {Early {{Crop Mapping Based}} on {{Sentinel-2 Time-Series Data}} and the {{Random Forest Algorithm}}},
  author = {Wei, Peng and Ye, Huichun and Qiao, Shuting and Liu, Ronghao and Nie, Chaojia and Zhang, Bingrui and Song, Lijuan and Huang, Shanyu},
  date = {2023-01},
  journaltitle = {Remote Sensing},
