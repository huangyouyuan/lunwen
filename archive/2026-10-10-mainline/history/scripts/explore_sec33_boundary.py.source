#!/usr/bin/env python3
"""Reuse the original seven boundary bands after identity/mask/CM checks.

All outputs are derived/exploratory. Error rates here are not class F1 or DR.
No band edges, predictions, or original files are changed.
"""
import argparse
import hashlib
import json
from pathlib import Path

import numpy as np
import pandas as pd
import tifffile

import explore_sec33 as core
from calculate_crop_f1 import within_site_file

BANDS = ['0<d<=1', '1<d<=2', '2<d<=3', '3<d<=4', '4<d<=5', '5<d<=6', 'd>6']
VERSION = 'class_shared_edge_center_edt_v1'
EXTERNAL_CM = [f'cm_{i}_{j}' for i in range(3) for j in range(3)]


def run(args):
    core.register(core.ROOT / 'legacy/manuscript/HLS-Crop/src/learning/distance_band_analysis.py', 'read-only distance definition; not re-executed')
    core.register(core.ROOT / 'legacy/manuscript/HLS-Crop/src/learning/spatial_stitching.py', 'reference export mapping target + 1; NoData 0')
    raw_w = core.read(core.ROOT / 'results/raw/within_site_confusion_matrices.csv').query("result_type == 'oof_pooled'").set_index(['model', 'target'])
    raw_c = core.read(core.ROOT / 'results/raw/cross_site_confusion_matrices.csv').set_index(['model', 'source', 'target', 'fold'])
    features = core.read(args.patch_dir / 'patch_spatial_features.csv').set_index('patch_uid')
    canonical, wrows, crows, identity = {}, [], [], []
    paths = []
    for model in core.MODELS:
        for site in core.SITES:
            paths.append((model, None, site + '_2023', within_site_file(model, site).parent))
    for folder in sorted(args.cross_dir.glob('*__*/')):
        model, source = folder.name.split('__')[:2]
        if model not in core.MODELS:
            continue
        for target_dir in sorted(folder.glob('*_2023')):
            paths.append((model, source, target_dir.name, target_dir))
    core.check('boundary 12 within / 36 cross inputs', len(paths) == 48)
    for model, source, target, folder in paths:
        assets = folder / 'details/reference_assets'
        cp = core.register(assets / 'reference_contract.json', 'boundary identity contract')
        contract = json.loads(cp.read_text(encoding='utf-8-sig'))
        core.check('boundary contract ' + str(folder), contract['distance_algorithm_version'] == VERSION and
                   contract['distance_unit'] == 'pixel' and contract['band_names'] == BANDS and
                   contract['band_edges'] == [0., 1., 2., 3., 4., 5., 6., 'inf'] and
                   contract['shape'] == [2560, 2560] and contract['spatial_contract']['dataset_id'] == target)
        bp = core.register(assets / 'distance_band_index.npy', 'original seven-band raster')
        dp = core.register(assets / 'class_boundary_distance_pixels.npy', 'original distance raster')
        rp = core.register(folder / 'maps/reference.tif', 'exported reference raster; 1 corn / 2 other / 3 soybean')
        with tifffile.TiffFile(rp) as ds:
            label = ds.asarray()
            geo = ds.geotiff_metadata
            core.check('boundary reference shape ' + target, label.shape == (2560, 2560))
            fields = contract['spatial_contract']['geo_fields']
            if geo is not None:
                core.check('boundary reference geometry ' + target,
                           geo['ProjectedCSTypeGeoKey'] == 5070 and tuple(geo['ModelPixelScale'][:2]) == (30, 30))
                core.check('boundary reference origin ' + target,
                           np.allclose(geo['ModelTiepoint'][3:5], [fields['gt_0'], fields['gt_3']], rtol=0, atol=1e-8))
            else:
                # Do not invent missing georeferencing: require an already checked
                # canonical raster and then verify entire pixel/mask arrays below.
                core.check('missing geotags has canonical reference', target in canonical)
        core.check('boundary exported class codes ' + target, np.isin(label, [1, 2, 3]).all())
        label_digest = hashlib.sha256(np.ascontiguousarray(label, dtype='uint8').tobytes()).hexdigest()
        signature = (label_digest, core.sha(bp), core.sha(dp), json.dumps(contract['spatial_contract'], sort_keys=True))
        label = label.astype(np.int16) - 1
        if target not in canonical:
            band = np.load(bp, allow_pickle=False)
            dist = np.load(dp, allow_pickle=False)
            core.check('boundary valid label/distance ' + target, np.isin(label, [0, 1, 2]).all() and np.isfinite(dist).all() and (dist > 0).all())
            reconstructed = np.searchsorted([1., 2., 3., 4., 5., 6.], dist, side='left')
            core.check('boundary distance to band ' + target, np.array_equal(band, reconstructed))
            counts = np.array([[np.sum((band == b) & (label == c)) for c in range(3)] for b in range(7)])
            for patch in range(400):
                row, col = divmod(patch, 20)
                tile = label[row*128:(row+1)*128, col*128:(col+1)*128]
                expected = features.loc[f'{target}__p{patch:04d}', [c + '_pixels' for c in core.CLASSES]].to_numpy(dtype=int)
                core.check('boundary reference patch counts', np.array_equal(np.bincount(tile.ravel(), minlength=3), expected))
            canonical[target] = (signature, counts, contract['reference_sha256'], core.sha(rp))
        core.check('same boundary reference/mask ' + str(folder), canonical[target][0] == signature)
        identity.append(dict(model=model, source=source or '', target=target, label_array_sha256=label_digest,
                             reported_reference_sha256=contract['reference_sha256'],
                             reported_fingerprint_matches_first=contract['reference_sha256'] == canonical[target][2],
                             geotiff_tags_present=geo is not None,
                             band_sha256=signature[1], distance_sha256=signature[2], reference_tif_sha256=core.sha(rp),
                             tif_file_matches_first=core.sha(rp) == canonical[target][3], result='Verified'))
        d = core.read(folder / 'distance_summary.csv', 'original band CM summaries')
        core.check('boundary file identity', d.model_name.eq(model).all() and d.eval_dataset_id.eq(target).all() and
                   d.distance_algorithm_version.eq(VERSION).all() and d.distance_unit.eq('pixel').all() and d.distance_status.eq('ok').all())
        if source:
            core.check('boundary source identity', d.train_dataset_id.eq(source).all())
        folds = d[d.result_type == 'fold']
        core.unique(folds, ['fold', 'band'], 35, 'boundary fold')
        core.check('boundary fold coverage', set(folds.fold) == set(range(1, 6)) and set(folds.band) == set(BANDS))
        selected = folds if source else d[d.result_type == 'oof_pooled']
        if not source:
            core.unique(selected, ['band'], 7, 'boundary pooled')
            core.check('boundary within folds to pooled', np.array_equal(
                folds.groupby('band')[EXTERNAL_CM].sum().sort_index().to_numpy(),
                selected.set_index('band')[EXTERNAL_CM].sort_index().to_numpy()))
        for fold, unit in selected.groupby('fold', dropna=False):
            base = raw_c.loc[(model, source, target, fold), core.CM] if source else raw_w.loc[(model, target), core.CM]
            core.check('boundary CM total to raw', np.array_equal(unit[EXTERNAL_CM].sum().to_numpy(), base.to_numpy()))
            for _, r in unit.iterrows():
                cm = r[EXTERNAL_CM].to_numpy(dtype=float).reshape(3, 3)
                core.check('boundary integer CM', np.isfinite(cm).all() and (cm >= 0).all() and (cm % 1 == 0).all())
                core.check('boundary named true classes', np.array_equal(cm.sum(axis=1), r[[f'true_{c}_pixels' for c in core.CLASSES]].to_numpy()))
                core.check('boundary mask row totals', np.array_equal(cm.sum(axis=1), canonical[target][1][BANDS.index(r.band)]))
                core.check('boundary pixels/errors', cm.sum() == r.valid_pixels and cm.sum()-np.trace(cm) == r.errors)
                out = dict(model=model, target=target, band=r.band, **dict(zip(core.CM, cm.ravel().astype(int))))
                if source:
                    out.update(source=source, fold=int(fold)); crows.append(out)
                else:
                    wrows.append(out)
    w, c = pd.DataFrame(wrows), pd.DataFrame(crows)
    core.save(w, core.PROC / 'boundary_within_cm.csv')
    core.save(c, core.PROC / 'boundary_cross_fold_cm.csv')
    core.save(pd.DataFrame(identity), core.SUM / 'boundary_identity_checks.csv')

    def summarize(df, keys):
        rows = []
        for key, unit in df.groupby(keys):
            total = unit[core.CM].sum().to_numpy(dtype=int).reshape(3, 3)
            for _, r in unit.iterrows():
                cm = r[core.CM].to_numpy(dtype=int).reshape(3, 3)
                for population in ['all', 'corn', 'soybean']:
                    if population == 'all':
                        n, errors = cm.sum(), cm.sum()-np.trace(cm)
                        n_total, errors_total = total.sum(), total.sum()-np.trace(total)
                    else:
                        i = core.CLASSES.index(population)
                        n, errors = cm[i].sum(), cm[i].sum()-cm[i, i]
                        n_total, errors_total = total[i].sum(), total[i].sum()-total[i, i]
                    rows.append(dict(zip(keys, key), band=r.band, population=population, pixels=int(n),
                        total_population_pixels=int(n_total), errors=int(errors),
                        error_rate=errors/n if n else np.nan, pixel_share=n/n_total if n_total else np.nan,
                        error_share=errors/errors_total if errors_total else np.nan,
                        overall_error_contribution=errors/n_total if n_total else np.nan))
        return pd.DataFrame(rows)

    ws = summarize(w, ['model', 'target'])
    cs = summarize(c, ['model', 'source', 'target', 'fold'])
    keys = ['model', 'target', 'band', 'population']
    z = cs.merge(ws[keys + ['errors', 'error_rate', 'overall_error_contribution']], on=keys,
                 suffixes=('', '_within'), validate='many_to_one')
    z['net_added_errors'] = z.errors - z.errors_within
    z['error_rate_difference'] = z.error_rate - z.error_rate_within
    z['net_overall_contribution'] = z.overall_error_contribution - z.overall_error_contribution_within
    groupkeys = ['model', 'source', 'target', 'band', 'population']
    numeric = ['errors', 'error_rate', 'error_share', 'overall_error_contribution', 'net_added_errors', 'error_rate_difference', 'net_overall_contribution']
    rows = []
    for key, x in z.groupby(groupkeys):
        core.check('five boundary predictions', len(x) == 5 and set(x.fold) == set(range(1, 6)))
        r = dict(zip(groupkeys, key), pixels=int(x.pixels.iloc[0]), pixel_share=x.pixel_share.iloc[0],
                 within_error_rate=x.error_rate_within.iloc[0], within_errors=int(x.errors_within.iloc[0]))
        for col in numeric:
            r[col + '_mean'] = x[col].mean() if x[col].notna().all() else np.nan
            r[col + '_std'] = x[col].std(ddof=1) if x[col].notna().all() else np.nan
        rows.append(r)
    core.save(ws, core.SUM / 'boundary_within_error.csv')
    core.save(z, core.SUM / 'boundary_cross_per_fold.csv')
    core.save(pd.DataFrame(rows), core.SUM / 'boundary_error_summary.csv')
    core.save(pd.DataFrame(core.CHECKS), core.SUM / 'boundary_checks.csv')
    manifest = dict(data_status='derived', analysis_status='exploratory', reuse_status='Verified',
                    metadata_status='Partially verified' if not all(x['reported_fingerprint_matches_first'] for x in identity) else 'Verified',
                    reported_fingerprint_mismatch_count=sum(not x['reported_fingerprint_matches_first'] for x in identity),
                    missing_geotiff_tags_count=sum(not x['geotiff_tags_present'] for x in identity),
                    limitations='Original EDT not rerun. Reported fingerprint mismatches retained, not repaired or explained. Current pixel arrays, geometry, distance/band arrays, class counts and CM closure checked directly.',
                    script_sha256=core.sha(__file__), inputs=list(core.INPUTS.values()),
                    output_sha256={str(p.relative_to(core.ROOT)): core.sha(p) for parent in [core.PROC, core.SUM] for p in parent.glob('boundary_*.csv')})
    (core.SUM / 'boundary_manifest.json').write_text(json.dumps(manifest, ensure_ascii=False, indent=2)+'\n', encoding='utf-8')
    print('Verified: boundary reuse, 48 identities, 12 within and 180 cross band-CM closures; 756 population/path/band summaries.')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--cross-dir', type=Path, default=Path('D:/cross_site_all_20260916'))
    parser.add_argument('--patch-dir', type=Path, default=Path('D:/cross_site_all_20260916/paper_tables/Patch级空间误差底表'))
    run(parser.parse_args())
