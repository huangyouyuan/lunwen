{
  "schema_version": 2,
  "purpose": "Keep results and small text records in the rebuilt remote; retain archives, binary assets and large files locally",
  "max_repository_bytes": 100000000,
  "max_file_bytes": 2000000,
  "allowed_extensions": [
    ".md",
    ".csv",
    ".tsv",
    ".json",
    ".tex",
    ".py",
    ".bib",
    ".txt",
    ".yaml",
    ".yml",
    ".toml",
    ".ini",
    ".cfg"
  ],
  "allowed_names": [
    ".gitignore",
    ".gitattributes"
  ],
  "allowed_exact": [
    ".githooks/pre-commit",
    ".githooks/pre-push",
    "output/README.md",
    "output/preview-manifest.json",
    "legacy/figures/four_site_classification/site_coordinates.csv",
    "legacy/figures/four_site_classification/verification.json",
    "legacy/figures/four_site_classification/研究区经纬度说明.md"
  ],
  "excluded_roots": [
    "archive",
    "output",
    "legacy",
    "word",
    "assets",
    ".claude"
  ],
  "excluded_directory_names": [
    "archive",
    "__pycache__",
    ".ipynb_checkpoints"
  ],
  "forbidden_extensions": [
    ".npz",
    ".npy",
    ".pdf",
    ".png",
    ".jpg",
    ".jpeg",
    ".tif",
    ".tiff",
    ".svg",
    ".doc",
    ".docx",
    ".zip",
    ".7z",
    ".rar",
    ".bundle",
    ".pth",
    ".pt",
    ".h5",
    ".hdf5",
    ".checkpoint",
    ".log",
    ".aux",
    ".xdv",
    ".source"
  ],
  "source_repository": "D:/AI/lunwen",
  "remote_repository": "https://github.com/huangyouyuan/lunwen.git",
  "old_history_copied": false,
  "automatic_commit": false,
  "automatic_push": false
}
